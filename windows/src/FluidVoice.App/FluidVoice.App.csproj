<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Namespaces/RootNamespace stay FluidVoice (internal, invisible) to avoid churn; the
         user-facing identity (exe, product) is LiquidFlow. -->
    <RootNamespace>FluidVoice</RootNamespace>
    <AssemblyName>LiquidFlow</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <Platforms>AnyCPU;ARM64;x64</Platforms>
    <Version>1.15.0</Version>
    <Product>LiquidFlow</Product>
    <Company>FluidVoice contributors</Company>
    <Copyright>GPLv3 — port of altic-dev/FluidVoice</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\fluidvoice.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\fluidvoice.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- keep WPF types unambiguous; WinForms/System.Drawing are used fully-qualified -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <!-- sherpa-onnx: Parakeet (NeMo transducer, ONNX) engine; ships win-arm64 + win-x64 native runtimes -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.3" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- seeds VoiceBox's preset-voice profiles into its SQLite db (voicebox.db) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- extracts the Kokoro TTS voice bundle (.tar.bz2) for the native Voices page.
         NU1902 (zip-slip in WriteEntryToDirectory, no patched release) is suppressed:
         we extract manually with our own path-traversal guard and a pinned trusted URL. -->
    <PackageReference Include="SharpCompress" Version="0.39.0" NoWarn="NU1902" />
    <!-- WebView2: hosts the React front-end (windows/web) as the app UI; Evergreen runtime, arm64 + x64 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
